---
import type { Scene } from "../data/scenes";

interface Props {
  scene: Scene;
}
const { scene: s } = Astro.props;
const paras = s.body ? (Array.isArray(s.body) ? s.body : [s.body]) : [];
---

<section class:list={["scene", { dark: s.dark }]} id={s.id} data-sky={s.sky.join(",")}>
  <div class="inner">
    <div class="kicker fx">{s.kicker}</div>
    {
      s.titleHtml ? (
        <h2 class="serif fx d1" set:html={s.titleHtml} />
      ) : (
        <h2 class="serif fx d1">
          {s.title[0]} <em>{s.title[1]}</em>
        </h2>
      )
    }
    {s.wall && <div class="wall fx d2">{s.wall}</div>}
    {paras.map((p) => <p class="body fx d3" set:html={p} />)}

    {
      s.images && (
        <div class="figures fx d3">
          {s.images.map((img) => (
            <figure class:list={{ wide: img.wide, fixed: !!img.height }} style={img.height ? `--fig-h: ${img.height}rem` : undefined}>
              {img.video ? (
                <video src={img.video} poster={img.src} autoplay muted loop playsinline preload="metadata" aria-label={img.alt} />
              ) : (
                <img src={img.src} alt={img.alt} loading="lazy" />
              )}
              {img.caption && <figcaption>{img.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )
    }

    {
      s.stats && (
        <div class="stats">
          {s.stats.map((st, i) => (
            <div class:list={["stat", "fx", `d${(i % 3) + 1}`]}>
              {typeof st.value === "number" ? (
                <div
                  class="n serif"
                  data-count={st.value}
                  data-prefix={st.prefix}
                  data-suffix={st.suffix}
                >
                  {st.prefix}0{st.suffix}
                </div>
              ) : (
                <div class="n serif">{st.value}</div>
              )}
              <div class="l">{st.label}</div>
            </div>
          ))}
        </div>
      )
    }

    {
      s.quotes && (
        <div class="quotes">
          {s.quotes.map((q, i) => (
            <blockquote class:list={["pull", "fx", `d${(i % 3) + 1}`]}>
              <p class="serif">“{q.text}”</p>
              <cite>{q.who}</cite>
            </blockquote>
          ))}
        </div>
      )
    }

    {s.coda && <div class="coda fx d3">{s.coda}</div>}

    {
      s.spectrum && (
        <>
          <div class="spec">
            {s.spectrum.map((d, i) => (
              <div class:list={["dom", "fx", `d${(i % 2) + 1}`]} style={`--dc:${d.color}`}>
                <h3>
                  <span class="dot" />
                  {d.title}
                </h3>
                <p>{d.body}</p>
              </div>
            ))}
          </div>
          <div class="specband fx d3" />
        </>
      )
    }

    {
      s.downloads && (
        <div class="downloads fx d3">
          <span class="dl-k">Download the app</span>
          {s.downloads.map((d) => (
            <a href={d.href}>
              ↓ {d.label}
              {d.detail && <small>{d.detail}</small>}
            </a>
          ))}
        </div>
      )
    }

    {
      s.links && (
        <div class="links fx d3">
          {s.links.map((l) => (
            <a href={l.href}>{l.label}</a>
          ))}
        </div>
      )
    }
  </div>
</section>
