<style is:global>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: linear-gradient(180deg, #f4efe6, #ece5d8); min-height: 100svh;
    color: #1d1b18;
    font-family: "Avenir Next", Avenir, "Segoe UI", system-ui, sans-serif;
    font-size: 16px; line-height: 1.55;
  }
  .serif { font-family: "Iowan Old Style", Palatino, "Palatino Linotype", Georgia, serif; }
  a { color: inherit; }

  nav { display: flex; justify-content: space-between; align-items: center; padding: 1.1rem 1.6rem; }
  nav a {
    font-size: .72rem; letter-spacing: .18em; text-transform: uppercase;
    text-decoration: none; border-bottom: 1px solid transparent;
  }
  nav a:hover { border-bottom-color: #1d1b18; }

  .wrap { max-width: 46rem; margin: 0 auto; padding: 2.5rem 1.6rem 4rem; }
  header h1 { font-weight: 400; font-size: clamp(2.2rem, 6vw, 3.4rem); line-height: 1.05; }
  .contact { margin-top: .9rem; font-size: .88rem; color: #5b564d; }
  .contact a { text-decoration: none; border-bottom: 1px solid #cfc7b8; }
  .contact span { margin: 0 .45rem; color: #b9b0a0; }
  .dl {
    display: inline-block; margin-top: 1.3rem; padding: .6rem 1.25rem;
    border: 1.5px solid #1d1b18; border-radius: 2rem; font-size: .82rem;
    letter-spacing: .1em; text-transform: uppercase; text-decoration: none;
  }
  .dl:hover { background: #1d1b18; color: #f4efe6; }

  h2 {
    font-weight: 400; font-size: .78rem; letter-spacing: .32em; text-transform: uppercase;
    color: #8a6d3d; margin: 2.6rem 0 1.1rem; padding-bottom: .45rem; border-bottom: 1px solid #ddd5c5;
  }
  .entry { margin-bottom: 1.35rem; }
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .role { font-weight: 600; font-size: 1.02rem; }
  .org { font-weight: 400; color: #5b564d; }
  .when { font-size: .8rem; color: #5b564d; font-style: italic; white-space: nowrap; }
  ul { list-style: none; margin-top: .45rem; }
  li { position: relative; padding-left: 1.05rem; margin-bottom: .3rem; font-size: .93rem; }
  li::before { content: "·"; position: absolute; left: .15rem; color: #8a6d3d; font-weight: 700; }
  .refs { font-size: .83rem; margin-top: .35rem; }
  .refs a { margin-right: 1.1rem; border-bottom: 1px solid #cfc7b8; text-decoration: none; }
  .skills { display: grid; grid-template-columns: max-content 1fr; gap: .35rem 1.2rem; }
  .skills dt { font-weight: 600; font-size: .9rem; }
  .skills dd { color: #5b564d; font-size: .9rem; }

  @media print {
    body { background: #fff; font-size: 10.5px; }
    nav, .dl { display: none; }
    .wrap { padding: 0; max-width: none; }
    h2 { margin-top: 1.2rem; }
  }
</style>
